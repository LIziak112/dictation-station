{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "title": {
      "default": "未命名听写",
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "subject": {
      "default": "mixed",
      "type": "string",
      "enum": [
        "english",
        "chinese",
        "mixed"
      ]
    },
    "stage": {
      "default": "",
      "type": "string",
      "maxLength": 20
    },
    "grade": {
      "default": "",
      "type": "string",
      "maxLength": 40
    },
    "textbook": {
      "default": "",
      "type": "string",
      "maxLength": 60
    },
    "unit": {
      "default": "",
      "type": "string",
      "maxLength": 60
    },
    "entries": {
      "minItems": 1,
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "wordId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "character",
              "word",
              "phrase",
              "sentence"
            ]
          },
          "reading": {
            "type": "string",
            "maxLength": 120
          },
          "en": {
            "type": "string",
            "maxLength": 300
          },
          "zh": {
            "type": "string",
            "maxLength": 300
          },
          "pinyin": {
            "type": "string",
            "maxLength": 300
          },
          "hint": {
            "type": "string",
            "maxLength": 500
          },
          "alt": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 300
            }
          },
          "modes": {
            "minItems": 1,
            "maxItems": 5,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "zh2en",
                "en2en",
                "en2zh",
                "zh_dictation",
                "pinyin2hanzi"
              ]
            }
          },
          "grade": {
            "type": "string",
            "maxLength": 40
          },
          "unit": {
            "type": "string",
            "maxLength": 60
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "entries"
  ],
  "additionalProperties": false
}
