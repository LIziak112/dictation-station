# 默认使用设备朗读，无需外部服务。
PORT=8083
HOST=127.0.0.1
DATA_DIR=./data
# nginx 剥离前缀时用 /，保留前缀时用 /tingxie/
BASE_PATH=/
# 是否允许注册；关闭后已有账号仍可登录。
ALLOW_REGISTRATION=true
# 仅当可信反代覆盖 x-real-ip 时开启。
TRUST_PROXY=false
# 图片识别可选，凭据只在服务端。
PADDLEOCR_TOKEN=
PADDLEOCR_URL=https://paddleocr.aistudio-app.com/api/v2/ocr/jobs
PADDLEOCR_MODEL=PaddleOCR-VL-1.6
# 服务器语音可选，需对应 Python 环境安装 edge-tts。
ENABLE_SERVER_TTS=false
EDGE_TTS_PYTHON=python3
EDGE_TTS_PYTHONPATH=
VOICE_ZH=zh-CN-XiaoxiaoNeural
VOICE_EN=en-US-AriaNeural

# 公开词典录音：英文索引与中文拼音定位 Wikimedia 许可录音；可关闭。
PUBLIC_DICTIONARY=true
# 可选部署者词书音频目录，内含 index.json 与音频文件。
WORD_AUDIO_DIR=
VOICE_EN_UK=en-GB-SoniaNeural
