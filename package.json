{
  "name": "dictation-station",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch apps/server/src/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "vite build && esbuild apps/server/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js && esbuild packages/mcp/src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/mcp.js",
    "start": "node server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "account:reset-password": "tsx scripts/reset-password.ts",
    "db:generate": "drizzle-kit generate",
    "schema:export": "tsx scripts/export-schema.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/server": "2.4.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "hono": "^4.13.9",
    "lucide-react": "^1.48.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
